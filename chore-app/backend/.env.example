# PostgreSQL connection string (required)
# Local dev example: postgresql://user:password@localhost:5432/choredb
# Render: copy the "Internal Database URL" from your Render PostgreSQL service
DATABASE_URL="postgresql://user:password@localhost:5432/choredb"

PORT=3000

# Optional: comma-separated list of allowed CORS origins
# Leave unset to allow all origins (fine for LAN / dev use)
# Example for Vercel: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=
